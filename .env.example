# Wzór pliku środowiskowego. Kopiuj do .env.local i uzupełnij — .env.local NIE trafia do gita.

# Firebase (klucze klienckie, publiczne z natury — bezpieczeństwa pilnują reguły i App Check)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App Check (reCAPTCHA v3)
VITE_RECAPTCHA_SITE_KEY=

# Zbieranie błędów (Sentry) — PUSTE = wyłączone i nawet niepobierane.
# ⚠️ Wpisanie DSN włącza NOWEGO PODPROCESORA w rozumieniu RODO: wymaga wiersza
# w Polityce §2/§5, w DPA §7 i erraty w pakiecie dla prawnika. To decyzja właściciela,
# nie krok techniczny. Szczegóły: src/monitoring.js
VITE_SENTRY_DSN=
