{
  "name": "domki",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "docs:docx": "node scripts/build-docx.mjs",
    "help:build": "node scripts/build-help-articles.mjs",
    "legal:build": "node scripts/build-legal.mjs",
    "og:build": "node scripts/build-og-image.mjs",
    "banery:build": "node scripts/build-social-banners.mjs",
    "patchnotes:build": "node scripts/build-patch-notes.mjs",
    "zdjecia:build": "node scripts/build-landing-photos.mjs",
    "deploy": "npm run build && firebase deploy",
    "test:prod": "playwright test --config=playwright.prod.config.js",
    "test:e2e": "cross-env VITE_USE_EMULATORS=true playwright test --workers=2",
    "test:e2e:ui": "cross-env VITE_USE_EMULATORS=true playwright test --ui",
    "test:e2e:debug": "cross-env VITE_USE_EMULATORS=true playwright test --debug",
    "test:e2e:local": "cross-env VITE_USE_EMULATORS=true playwright test",
    "test:podatki": "node --test src/utils/taxSummary.test.mjs src/utils/taxExport.test.mjs",
    "zrzuty:build": "cross-env VITE_USE_EMULATORS=true playwright test --config=playwright.zrzuty.config.js"
  },
  "dependencies": {
    "@sentry/react": "^10.74.0",
    "@tanstack/react-query": "^5.102.8",
    "firebase": "^12.19.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.46.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.5",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.3",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.0",
    "cross-env": "^10.1.0",
    "docx": "^9.7.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "firebase-tools": "^15.30.0",
    "globals": "^17.12.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "vite": "^8.3.0"
  }
}
