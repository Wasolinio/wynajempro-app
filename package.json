{
  "name": "domki",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "docs:docx": "node scripts/build-docx.mjs",
    "help:build": "node scripts/build-help-articles.mjs",
    "deploy": "npm run build && firebase deploy",
    "test:prod": "playwright test --config=playwright.prod.config.js",
    "test:e2e": "cross-env VITE_USE_EMULATORS=true playwright test --workers=2",
    "test:e2e:ui": "cross-env VITE_USE_EMULATORS=true playwright test --ui",
    "test:e2e:debug": "cross-env VITE_USE_EMULATORS=true playwright test --debug",
    "test:e2e:local": "cross-env VITE_USE_EMULATORS=true playwright test"
  },
  "dependencies": {
    "@sentry/react": "^10.70.0",
    "@tanstack/react-query": "^5.101.4",
    "firebase": "^12.17.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.31.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.2",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10.1.0",
    "docx": "^9.7.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "firebase-tools": "^15.27.0",
    "globals": "^17.11.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.2.4",
    "vite": "^8.2.1"
  }
}
