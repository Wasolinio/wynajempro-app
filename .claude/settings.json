{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__firebase__firestore_query_collection",
      "mcp__firebase__firestore_get_document",
      "mcp__firebase__firestore_list_collections",
      "mcp__firebase__firestore_list_documents",
      "mcp__firebase__auth_get_users",

      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run test:e2e)",
      "Bash(npm run docs:docx)",
      "Bash(npx vite build)",
      "Bash(npx playwright test *)",
      "Bash(npx eslint src e2e)",
      "Bash(node --check *)",
      "Bash(node scripts/build-docx.mjs *)",

      "Bash(firebase functions:log *)",
      "Bash(firebase firestore:databases:get *)",
      "Bash(firebase firestore:databases:list)",
      "Bash(firebase firestore:backups:schedules:list)",
      "Bash(firebase firestore:backups:list *)",
      "Bash(firebase projects:list)",
      "Bash(firebase login:list)",

      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",

      "mcp__Claude_Browser__read_page",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__resize_window",
      "mcp__Claude_Browser__preview_logs",
      "mcp__Claude_Browser__preview_list",

      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__tabs_context_mcp"
    ],
    "deny": [
      "mcp__firebase__firestore_delete_database",
      "mcp__firebase__firestore_delete_document",
      "mcp__firebase__firestore_update_document",
      "mcp__firebase__firestore_add_document",
      "mcp__firebase__firestore_update_database",
      "mcp__firebase__firestore_create_database",
      "mcp__firebase__firestore_create_index",
      "mcp__firebase__firestore_delete_index",
      "mcp__firebase__auth_update_user",
      "mcp__firebase__auth_set_sms_region_policy",
      "mcp__firebase__firebase_deploy",
      "mcp__firebase__firebase_init",
      "mcp__firebase__firebase_login",
      "mcp__firebase__firebase_logout",
      "mcp__firebase__firebase_update_environment",
      "mcp__firebase__firebase_create_project",
      "mcp__firebase__firebase_create_app",
      "mcp__firebase__firebase_create_android_sha"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/eslint-po-edycji.sh\"",
            "timeout": 60,
            "statusMessage": "ESLint na zmienionym pliku"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/blokada-slepego-deployu.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
