rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fallback subskrypcji z dokumentu users — lustro checkFallbackSubscription
    // z firestore.rules (status kanoniczne, accountStatus historyczne).
    function hasActiveSubscriptionDoc(uid) {
      let docData = firestore.get(/databases/(default)/documents/users/$(uid)).data;
      let status = docData.get('status', docData.get('accountStatus', 'none'));
      return status == 'active'
          || (status == 'trialing'
              && docData.get('trialEndsAt', null) != null
              && docData.trialEndsAt is timestamp
              && docData.trialEndsAt > request.time);
    }

    // Zdjęcia zadań (moduł Zadania, E3 partia 2): users/{uid}/tasks/{taskId}/{plik}.
    // Dostęp PO ŚCIEŻCE (przez SDK) ma wyłącznie właściciel — w odróżnieniu od guides/
    // nie ma tu publicznego odczytu.
    //
    // ⚠️ CZEGO TA REGUŁA NIE CHRONI, a co łatwo jej przypisać: klient zapisuje przy
    // zdjęciu wynik `getDownloadURL()` (WynajemContext.addTaskPhoto), a taki adres niesie
    // token pobrania i działa BEZ uwierzytelnienia — inaczej kafelki `<img src=...>`
    // w dialogu w ogóle by się nie renderowały. Kto zna adres, ten widzi plik: reguła
    // `read` zabezpiecza ścieżkę, prywatności pilnuje nieodgadywalność tokenu.
    // Dlatego kasowanie zdjęcia i usunięcie zadania MUSZĄ realnie kasować plik
    // (token żyje tak długo jak obiekt) — patrz deleteTask w WynajemContext.
    // Zdjęcia bywają wnętrzami i rzeczami gości → do oceny przez `legal`, czy zostajemy
    // przy tokenie, czy przechodzimy na pobieranie uwierzytelnione (getBlob + CORS bucketu).
    //
    // Zapis jak w guides/: zweryfikowany subskrybent, < 10 MB, ale WYŁĄCZNIE obrazy.
    // 🛡️ create/update i delete rozdzielone ŚWIADOMIE: jeden blok `write` z gałęzią
    // `request.resource == null` opierałby kasowanie na niepotwierdzonym założeniu
    // (dokumentacja wymienia request.resource jako dostępny także przy delete), a Storage
    // nie ma w tym projekcie lustrzanego testera, więc pomyłka wyszłaby dopiero na
    // produkcji — jako ciche „nie da się usunąć zdjęcia" (przegląd 2026-08-29).
    // Czyszczenie przy usuwaniu konta: cleanupUserData w functions/index.js kasuje
    // cały prefiks users/{uid}/tasks/ (RODO art. 17).
    match /users/{uid}/tasks/{taskId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
                   && request.auth.uid == uid
                   && request.auth.token.get('email_verified', false) == true
                   && (request.auth.token.get('stripeStatus', '') == 'active'
                       || hasActiveSubscriptionDoc(uid))
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && request.auth.uid == uid
                    && request.auth.token.get('email_verified', false) == true
                    && (request.auth.token.get('stripeStatus', '') == 'active'
                        || hasActiveSubscriptionDoc(uid));
    }

    match /guides/{guideId}/{fileName} {
      // Publiczny odczyt zdjęć i dokumentów w przewodnikach (goście potrzebują dostępu)
      allow read: if true;

      // Zapis (N2): zweryfikowany subskrybent; dla ISTNIEJĄCEGO przewodnika tylko
      // jego właściciel (cross-service check do Firestore). Przewodnik jeszcze
      // niezapisany (upload okładki przed pierwszym „Zapisz" w GuideBuilder) →
      // przepuszczamy subskrybenta; id przewodnika to guide_{UUID} (nieodgadywalne).
      // Subskrypcja: claim stripeStatus (szybka ścieżka) lub dokument users
      // (active / trialing z żywym Timestampem) — lustro hasActiveSubscription
      // z firestore.rules.
      allow write: if request.auth != null
                   && request.auth.token.get('email_verified', false) == true
                   && (request.auth.token.get('stripeStatus', '') == 'active'
                       || hasActiveSubscriptionDoc(request.auth.uid))
                   && (!firestore.exists(/databases/(default)/documents/guides/$(guideId))
                       || firestore.get(/databases/(default)/documents/guides/$(guideId)).data.ownerId == request.auth.uid)
                   && request.resource.size < 10 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*') ||
                       request.resource.contentType == 'application/pdf' ||
                       request.resource.contentType == 'application/msword' ||
                       request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }
  }
}
